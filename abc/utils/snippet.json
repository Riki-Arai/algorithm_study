		"prefix": "imos_2D",
		"body": [
			"# H: 行数, W: 列数",
			"H, W = 100, 100",
			"imos_lists = [[0] * (W + 2) for _ in range(H + 2)]",
			"for _ in range(N):",
			"    y1, y2, x1, x2 = map(int, input().split())",
			"    imos_lists[y1][x1] += 1          # 左上（始点）",
			"    imos_lists[y1][x2 + 1] -= 1      # 右上（x方向の終点の 1つ右）",
			"    imos_lists[y2 + 1][x1] -= 1      # 左下（y方向の終点の 1つ下）",
			"    imos_lists[y2 + 1][x2 + 1] += 1  # 右下（重複して引いた分を戻す）",
			"",
			"# 横方向の累積和",
			"for y in range(1, H + 2):",
			"    for x in range(1, W + 2):",
			"        imos_lists[y][x] += imos_lists[y][x - 1]",
			"",
			"# 縦方向の累積和",
			"for y in range(1, H + 2):",
			"    for x in range(1, W + 2):",
			"        imos_lists[y][x] += imos_lists[y - 1][x]"
		],
		"description": "2次元imos法"
