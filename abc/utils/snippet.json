    "eratosthenes": {
        "prefix": "eratos",
        "body": [
        "# 計算量はO(NloglogN)",
        "def sieve_of_eratosthenes(n: int) -> list[int]:",
        "    \"\"\"n以下の素数を高速に列挙する (エラトステネスの篩)\"\"\"",
        "    if n < 2:",
        "        return []",
        "    ",
        "    size = (n - 1) // 2 + 1",
        "    is_prime = [True] * size",
        "    is_prime[0] = False",
        "    ",
        "    for i in range(1, int(n**0.5) // 2 + 1):",
        "        if is_prime[i]:",
        "            p = 2 * i + 1",
        "            start = (p * p) // 2",
        "            is_prime[start::p] = [False] * ((size - start - 1) // p + 1)",
        "            ",
        "    return [2] + [2 * i + 1 for i, prime in enumerate(is_prime) if prime]"
        ],
        "description": "エラトステネスの篩（スライス高速化＆偶数スキップ版）でn以下の素数を列挙する。"
    },
    "divisors_list_func": {
        "prefix": "divlist_for_n",
        "body": [
        "# 計算量はO(√n)",
        "def divisors(n: int) -> list:",
        "    res = []",
        "    i = 1",
        "    while i * i <= n:",
        "        if n % i == 0:",
        "            res.append(i)",
        "            if i * i != n:",
        "                res.append(n // i)",
        "        i += 1",
        "    res.sort()",
        "    return res"
        ],
        "description": "nの正の約数を小さい順に返す"
    },
