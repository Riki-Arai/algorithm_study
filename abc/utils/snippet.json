    "Bellman-Ford (All Negative)": {
    "prefix": "bellman_ford",
    "body": [
      "INF = 10**36",
      "def bellman_ford_all_negative(G, s):",
      "    \"\"\"",
      "    1つのスタート地点を起点とした最短経路を求める時に使用し、計算量はO(VE)(すべての点を対象にする場合はワーシャルフロイド法)",
      "    s: スタートとなる頂点の番号",
      "    G: 隣接グラフ(例：[[(2, 10), (3, 50)], [(3, 20)], [(4, -40)], [(1, 10)]]) ※要素の意味は(接続している頂点、重み)",
      "    ",
      "    返り値:",
      "    costs: 頂点sからの最小コスト（負の閉路がある場合は正確なものではなくなるので注意）",
      "    negative: ある頂点が負の閉路の影響を受けるかどうかの真偽値リスト",
      "    \"\"\"",
      "    n = len(G)",
      "    costs = [INF] * n",
      "    costs[s] = 0",
      "    ",
      "    # 1. 通常の最短経路計算（V-1回の更新）",
      "    for _ in range(n - 1):",
      "        for v in range(n):",
      "            if costs[v] == INF:",
      "                continue",
      "            for to, c in G[v]:",
      "                if costs[to] > costs[v] + c:",
      "                    costs[to] = costs[v] + c",
      "                    ",
      "    # 2. 負の閉路の検出と影響の伝播（さらにV回の更新）",
      "    # negative[i] = True なら、スタートから頂点iへのコストは -無限大",
      "    negative = [False] * n",
      "    for _ in range(n):",
      "        for v in range(n):",
      "            if costs[v] == INF:",
      "                continue",
      "            for to, c in G[v]:",
      "                # 「通常通り更新される」または「遷移元がすでに負の閉路の影響下にある」場合",
      "                if costs[to] > costs[v] + c or negative[v]:",
      "                    costs[to] = costs[v] + c",
      "                    negative[to] = True",
      "                    ",
      "    return costs, negative",
      "$0"
    ],
    "description": "Bellman-Ford algorithm to detect all nodes affected by negative cycles."
    },
