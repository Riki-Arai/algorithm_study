    "is_edit": {
        "prefix": "is_edit",
        "body": [
        "def is_edit_distance_leq_n(s: str, t: str, n: int) -> bool:",
        "    if abs(len(s) - len(t)) > n:",
        "        return False",
        "",
        "    if len(s) > len(t):",
        "        s, t = t, s",
        "",
        "    ls, lt = len(s), len(t)",
        "    if ls == lt:",
        "        diff = sum(1 for a, b in zip(s, t) if a != b)",
        "        return diff <= n",
        "",
        "    i = j = 0",
        "    edits = 0",
        "    while i < ls and j < lt:",
        "        if s[i] == t[j]:",
        "            i += 1",
        "            j += 1",
        "        else:",
        "            edits += 1",
        "            if edits > n:",
        "                return False",
        "            j += 1",
        "    edits += (lt - j)",
        "    return edits <= n"
        ],
        "description": "編集距離がn以下か判定"
    },
