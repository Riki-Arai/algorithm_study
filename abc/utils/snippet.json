    "Combination Memo": {
        "prefix": "comb_memo",
        "body": [
            "class Combination:",
            "",
            "    def __init__(self, max_n: int, mod: int = 10**9 + 7):",
            "        self.mod = mod",
            "        self.fact = [1] * (max_n + 1)",
            "        self.inv_fact = [1] * (max_n + 1)",
            "",
            "        # 階乗の計算 O(N)",
            "        for i in range(1, max_n + 1):",
            "            self.fact[i] = (self.fact[i - 1] * i) % self.mod",
            "",
            "        # フェルマーの小定理より、fact[MAX] の逆元を求める",
            "        self.inv_fact[max_n] = pow(self.fact[max_n], self.mod - 2, self.mod)",
            "",
            "        # 階乗の逆元を後ろからテーブル化 O(N)",
            "        for i in range(max_n - 1, -1, -1):",
            "            self.inv_fact[i] = (self.inv_fact[i + 1] * (i + 1)) % self.mod",
            "",
            "    def get(self, n: int, k: int) -> int:",
            "        if k < 0 or k > n:",
            "            return 0",
            "        return self.fact[n] * self.inv_fact[k] % self.mod * self.inv_fact[n - k] % self.mod",
            "",
            "MOD = 10**9 + 7",
            "comb = Combination(N, MOD)"
        ],
        "description": "メモとMODを利用することで、同じ組み合わせの計算を高速に導出"
    },
